<?xml version="1.0" encoding="UTF-8"?>
<mule xmlns:json-logger="http://www.mulesoft.org/schema/mule/json-logger" xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:apikit="http://www.mulesoft.org/schema/mule/mule-apikit" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation" xmlns:ee="http://www.mulesoft.org/schema/mule/ee/core" xmlns:http="http://www.mulesoft.org/schema/mule/http" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd http://www.mulesoft.org/schema/mule/http http://www.mulesoft.org/schema/mule/http/current/mule-http.xsd http://www.mulesoft.org/schema/mule/mule-apikit http://www.mulesoft.org/schema/mule/mule-apikit/current/mule-apikit.xsd http://www.mulesoft.org/schema/mule/ee/core http://www.mulesoft.org/schema/mule/ee/core/current/mule-ee.xsd 
http://www.mulesoft.org/schema/mule/json-logger http://www.mulesoft.org/schema/mule/json-logger/current/mule-json-logger.xsd">
	<flow name="customer-prc-api-main" doc:id="1df62b03-8e63-45e9-ab21-953385a1168e">
        <http:listener config-ref="customer-prc-api-http-listener-config" path="/*">
            <http:response statusCode="#[vars.httpStatus default 200]">
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:response>
            <http:error-response statusCode="#[vars.httpStatus default 500]">
                <http:body><![CDATA[#[payload]]]></http:body>
                <http:headers><![CDATA[#[vars.outboundHeaders default {}]]]></http:headers>
            </http:error-response>
        </http:listener>
        <apikit:router config-ref="customer-prc-api-config" />
    </flow>
    <flow name="put:\api\v1\customers\(customerId):application\json:customer-prc-api-config">
        <json-logger:logger doc:name="log-put-customer-orders-start" doc:id="f1046018-2eab-44c2-bbe8-9c064eac0d2a" config-ref="json-logger-config" message="#[&quot;----------&quot; ++ upper(&quot;log-put-customer-records-start&quot;) ++ '----------']">
			<json-logger:content><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="set-request-params-sub-flow-reference" doc:id="cdc9a508-f81e-4344-b1b8-11819f341e54" name="set-request-params-sub-flow" target="requestParams" />
		<flow-ref doc:name="put-customer-details-sub-flow" doc:id="2337e823-e3fa-45bc-ba2a-735b1eeccf9f" name="put-customer-details-sub-flow"/>
        <ee:transform doc:name="response-payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Customer record updated successfully",
  customerId: vars.requestParams.uriParams.customerId,
  updatedFields: vars.requestParams.payload,
  lastUpdated: now()
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
		<json-logger:logger doc:name="log-put-customer-orders-end" doc:id="c8d54e6d-eceb-489d-82f3-fccaa86e808a" config-ref="json-logger-config" message="#[&quot;----------&quot; ++ upper(&quot;log-put-customer-records-end&quot;) ++ '----------']" >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
    </flow>
	<flow name="delete:\api\v1\customers\(customerId):application\json:customer-prc-api-config">
        <json-logger:logger doc:name="log-delete-customer-record-start" doc:id="cac33b6b-a648-427f-97d4-4e3b35663523" config-ref="json-logger-config" message='#["-----------" ++ upper("log-delete-customer-record-start") ++ "----------"]' />
		<flow-ref doc:name="set-request-params-sub-flow-reference" doc:id="cdc59c80-8ea1-4766-8766-cafbd25b78d1" name="set-request-params-sub-flow" target="requestParams" />
		<flow-ref doc:name="delete-customer-sub-flow" doc:id="c80b839f-8d32-4ab2-a0c9-72da1d70bb35" name="delete-customer-sub-flow"/>
		<ee:transform doc:name="response-payload">
            <ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"message": vars.requestParams.uriParams.customerId as String ++ "successfully Deleted"
}]]></ee:set-payload>
			</ee:message>
			<ee:variables>
                <ee:set-variable variableName="customerId"><![CDATA[attributes.uriParams.'customerId']]></ee:set-variable>
            </ee:variables>
        </ee:transform>
		<json-logger:logger doc:name="log-delete-customer-record-end" doc:id="f9e4970e-29c1-40f5-932e-3c309c874a44" config-ref="json-logger-config" message='#["-----------" ++ upper("log-delete-customer-record-end") ++ "----------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
    </flow>
    <flow name="get:\api\v1\customers:customer-prc-api-config" doc:id="e3f107b5-19ca-462c-aed2-3f04251536ce">
        <json-logger:logger doc:name="log-get-customers-data-start" doc:id="c0fa7af9-85de-4647-ae1b-b2bea6932cdf" config-ref="json-logger-config" message='#["----------" ++ upper("log-get-customers-data-start") ++ "----------"]'>
			<json-logger:content><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="set-request-params-sub-flow-reference" doc:id="a6668183-0981-4255-88dd-d4f7ef8aa29c" name="set-request-params-sub-flow" target="requestParams" />
		<flow-ref doc:name="get-customers-data-sub-flow" doc:id="9a878059-27c4-4352-b31f-a16f2cacd585" name="get-customers-data-sub-flow"/>
		<ee:transform doc:name="response-payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map {
  "customerId": $.Customer_Id__c,
  "name": $.Name__c,
  "isActive": $.IsActive__c,
  "pincode": $.Pincode__c,
  "registrationDate": $.Registration_Date__c,
  "address": $.Registration_Date__c,
  "city": $.City__c,
  "contact": $.contact__c,
  "id": $.Id,
  "state": $.State__c,
  "email": $.Email__c
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
		<json-logger:logger doc:name="log-get-customers-data-end" doc:id="9ba699e1-63b5-41fa-8e3a-2064033c8b0e" config-ref="json-logger-config" message='#["----------" ++ upper("log-get-customers-data-end") ++ "----------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
    </flow>
    <flow name="get:\api\v1\customers\(customerId)\orders:customer-prc-api-config">
        <json-logger:logger doc:name="log-get-customer-orders-start" doc:id="5645be77-f196-4645-a47f-eb96af316612" config-ref="json-logger-config" message="#[&quot;----------&quot; ++ upper(&quot;log-get-customer-records-start&quot;) ++ '----------']">
			<json-logger:content><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="set-request-params-sub-flow-reference" doc:id="295ff4fd-9e97-49d9-bd79-bd1e01d246a7" name="set-request-params-sub-flow" target="requestParams" />
		<flow-ref doc:name="get-customer-orders-sub-flow" doc:id="46e12bc8-f3b9-48c6-a382-c65a0e21a5b5" name="get-customer-orders-sub-flow"/>
        <ee:transform doc:name="response-payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
payload map {
  "inventory": $.Inventory__c,
  "orderStatus": $.Order_Status__c,
  "totalPrice": $.Total_Price__c,
  "orderDate": $.Order_Date__c,
  "warehouseCity": $.warehouse_city__c,
  "deliveryPartner": $.DeliveryPartner__c,
  "customerId": $.Customer__c,
  "quantity": $.Quantity__c,
  "invoice": $.Invoice__c,
  "orderId": $.Order_Id__c,
  "deliveryAddress": $.Delivery_Address__c,
  "id": $.Id,
  "isCancelled": $.IsCancelled__c,
  "deliveryDate": $.Delivery_Date__c,
  "transit": $.Transit__c
}
]]></ee:set-payload>
            </ee:message>
        </ee:transform>
		<json-logger:logger doc:name="log-get-customer-orders-end" doc:id="60e778ef-6c3c-4a37-b11c-d231e4c08a59" config-ref="json-logger-config" message="#[&quot;----------&quot; ++ upper(&quot;log-get-customer-records-end&quot;) ++ '----------']" >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
    </flow>
    <flow name="get:\api\v1\customers\(customerId):customer-prc-api-config">
        <json-logger:logger doc:name="log-get-customer-details-start" doc:id="0db0adf8-bae9-4455-8c53-4ca1081fa5c6" config-ref="json-logger-config" message="#[&quot;----------&quot; ++ upper(&quot;log-get-customer-records-start&quot;) ++ '----------']">
			<json-logger:content><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="set-request-params-sub-flow-reference" doc:id="950e3e67-ba5a-4ad3-b716-26992dfbb3fa" name="set-request-params-sub-flow" target="requestParams" />
		<flow-ref doc:name="get-customer-details-sub-flow" doc:id="eeb68c4f-b50a-45ac-9ed0-4a67791e6d77" name="get-customer-details-sub-flow"/>
        <ee:transform doc:name="response-payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  "customerId": payload[0].Customer_Id__c,
  "name": payload[0].Name__c,
  "isActive": payload[0].IsActive__c,
  "pincode": payload[0].Pincode__c,
  "registrationDate": payload[0].Registration_Date__c,
  "address": payload[0].Registration_Date__c,
  "city": payload[0].City__c,
  "contact": payload[0].contact__c,
  "id": payload[0].Id,
  "state": payload[0].State__c,
  "email": payload[0].Email__c
}]]></ee:set-payload>
            </ee:message>
        </ee:transform>
		<json-logger:logger doc:name="log-get-customer-details-end" doc:id="0924c1d0-4971-48eb-9076-18951ddf1828" config-ref="json-logger-config" message="#[&quot;----------&quot; ++ upper(&quot;log-get-customer-records-end&quot;) ++ '----------']" >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
    </flow>
    <flow name="post:\api\v1\customers:application\json:customer-prc-api-config">
        <json-logger:logger doc:name="log-post-customer-record-start" doc:id="4bf877bc-a788-4ead-b3f4-136250472cf6" config-ref="json-logger-config" message="#[&quot;----------&quot; ++ upper(&quot;log-post-customer-record-start&quot;) ++ '----------']">
			<json-logger:content><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="set-request-params-sub-flow-reference" doc:id="a3e1b117-38e5-411a-b32b-7ed8d8a10cc6" name="set-request-params-sub-flow" target="requestParams" />
		<flow-ref doc:name="post-customer-record-sub-flow" doc:id="5881e244-df1d-4e5b-be0e-e27988049e9f" name="post-customer-record-sub-flow"/>
		<ee:transform doc:name="response-payload">
            <ee:message>
                <ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
  message: "Customer record created successfully",
  customerId: vars.requestParams.payload.customerId,
  name: vars.requestParams.payload.name,
  email: vars.requestParams.payload.email,
  createdAt: now()
} ]]></ee:set-payload>
            </ee:message>
        </ee:transform>
		<json-logger:logger doc:name="log-post-customer-record-end" doc:id="4ddfa0b5-e9c7-4dbe-9627-2177a03d06e3" config-ref="json-logger-config" message="#[&quot;----------&quot; ++ upper(&quot;log-post-customer-record-end&quot;) ++ '----------']" >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
    </flow>
</mule>
