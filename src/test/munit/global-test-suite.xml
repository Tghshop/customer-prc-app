<?xml version="1.0" encoding="UTF-8"?>

<mule xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:munit="http://www.mulesoft.org/schema/mule/munit" xmlns:munit-tools="http://www.mulesoft.org/schema/mule/munit-tools"
	xmlns="http://www.mulesoft.org/schema/mule/core" xmlns:doc="http://www.mulesoft.org/schema/mule/documentation"
	xsi:schemaLocation="
		http://www.mulesoft.org/schema/mule/core http://www.mulesoft.org/schema/mule/core/current/mule.xsd
		http://www.mulesoft.org/schema/mule/munit http://www.mulesoft.org/schema/mule/munit/current/mule-munit.xsd
		http://www.mulesoft.org/schema/mule/munit-tools  http://www.mulesoft.org/schema/mule/munit-tools/current/mule-munit-tools.xsd">
	<munit:config name="global-test-suite.xml" />
	<munit:test name="customer-prc-api-global-error-handler-test" doc:id="25e0cc9f-63cb-4458-ac70-edab4282a022" description="Test" >
		<munit:behavior >
			<munit-tools:mock-when doc:name="Mocking-request-sf-sys-app" doc:id="2c341e91-6299-4431-9819-d65b8ed19857" processor="apikit:router">
				<munit-tools:with-attributes >
					<munit-tools:with-attribute whereValue="customer-prc-api-config" attributeName="config-ref" />
				</munit-tools:with-attributes>
				<munit-tools:then-return >
					<munit-tools:error typeId="ANY" />
				</munit-tools:then-return>
			</munit-tools:mock-when>
		</munit:behavior>
		<munit:execution >
			<try doc:name="Try" doc:id="243d96f1-7283-4946-ab49-90256c935021" >
				<flow-ref doc:name="customer-prc-api-main" doc:id="b13369c9-b795-400c-9513-d9a1046d1018" name="customer-prc-api-main" />
				<error-handler >
					<on-error-continue enableNotifications="true" logException="true" doc:name="On Error Continue" doc:id="a00bf1af-20bd-4df1-b96e-3f984cfd01a6" type="ANY" >
						<logger level="INFO" doc:name="Logger" doc:id="d4d78324-7ab7-42cd-8dbf-7280ae145a7e" message="#[payload]" />
					</on-error-continue>
				</error-handler>
			</try>
		</munit:execution>
		<munit:validation >
			<munit-tools:assert-equals doc:name="Assert equals" doc:id="fb51e6f8-d627-4448-9b5f-40bfa2174dc6" actual="#[payload.status]" expected='#["ERROR"]' />
		</munit:validation>
	</munit:test>


</mule>
